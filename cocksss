local EventTab = Window:Tab({Title = "Event", Icon = "house"})

local isAutoHouses = false
local standDelay = 1
local teleportDelay = 0.1

-- Load saved values
standDelay = tonumber(getConfig("StandDelay", "1")) or 1
teleportDelay = tonumber(getConfig("TeleportDelay", "0.1")) or 0.1

