--// CONFIG SYSTEM -----------------------------------------------------------
local CONFIG_FOLDER = Instance.new("Folder")
CONFIG_FOLDER.Name = ".ftgs_config"
CONFIG_FOLDER.Parent = Workspace

local function getConfig(name, default)
    local cfg = CONFIG_FOLDER:FindFirstChild(name)
    if cfg and cfg:IsA("StringValue") then
        return cfg.Value
    end
    local val = Instance.new("StringValue")
    val.Name = name
    val.Value = tostring(default)
    val.Parent = CONFIG_FOLDER
    return tostring(default)
end

local function setConfig(name, value)
    local cfg = CONFIG_FOLDER:FindFirstChild(name)
    if not cfg then
        cfg = Instance.new("StringValue")
        cfg.Name = name
        cfg.Parent = CONFIG_FOLDER
    end
    cfg.Value = tostring(value)
end

