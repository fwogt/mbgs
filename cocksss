EventTab:Slider({
    Title = "Stand Delay (seconds)",
    Min = 0.5, Max = 5, Default = standDelay, Step = 0.1,
    Callback = function(val) 
        standDelay = val
        setConfig("StandDelay", val)
    end
})

EventTab:Slider({
    Title = "Teleport Delay (seconds)",
    Min = 0.1, Max = 2, Default = teleportDelay, Step = 0.1,
    Callback = function(val)
        teleportDelay = val
        setConfig("TeleportDelay", val)
    end
})

local function teleportTo(cf)
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then root.CFrame = cf end
end

local function getDistance(part)
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root and part then return (root.Position - part.Position).Magnitude end
    return math.huge
end

local function standAndClaim(targetPart)
    local base = targetPart.CFrame * CFrame.new(0, 3, 0)
    local offset = targetPart.CFrame * CFrame.new(5, 3, 0)
    teleportTo(offset); task.wait(0.1)
    teleportTo(base)
    for i = 1, math.floor(standDelay) do
        if not isAutoHouses then break end
        teleportTo(base * CFrame.new(0, i, 0))
        task.wait(1)
    end
    if standDelay > math.floor(standDelay) then task.wait(standDelay - math.floor(standDelay)) end
end

task.spawn(function()
    while true do
        if not isAutoHouses then task.wait(0.1); continue end
        local halloween = Workspace:FindFirstChild("HalloweenEvent")
        if not halloween then task.wait(1); continue end
        local houses = halloween:FindFirstChild("Houses")
        if not houses then task.wait(1); continue end
        local valid = {}
        for _, h in ipairs(houses:GetChildren()) do
            local act = h:FindFirstChild("Activation")
            if act and act:FindFirstChild("Active") and act.Active.Value then
                local p = act.PrimaryPart or act:FindFirstChildWhichIsA("BasePart")
                if p then table.insert(valid, {house = h, dist = getDistance(p)}) end
            end
        end
        table.sort(valid, function(a,b) return a.dist < b.dist end)
        for _, v in ipairs(valid) do
            if not isAutoHouses then break end
            local act = v.house:FindFirstChild("Activation")
            if act then
                local p = act.PrimaryPart or act:FindFirstChildWhichIsA("BasePart")
                if p then standAndClaim(p) end
            end
        end
        task.wait(teleportDelay)
    end
end)

