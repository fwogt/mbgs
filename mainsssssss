--- Stops all running auto-potion loops
function StopAutoPotionLoops()
    print("Stopping auto-potion loops...")
    isAutoPotionEnabled = false
    for i, thread in ipairs(autoPotionLoops) do
        task.cancel(thread)
    end
    autoPotionLoops = {}
end

--- Starts auto-potion loops for all selected potions
function StartAutoPotionLoops()
    StopAutoPotionLoops()
    isAutoPotionEnabled = true
    
    local selectedPotions = AutoPotionsSelect.Value
    if #selectedPotions == 0 then
        print("Auto-Potions: No potions selected.")
        return
    end

    print("Starting auto-potion loops for", #selectedPotions, "potion(s)...")

    for _, displayName in ipairs(selectedPotions) do
        local potionName, potionLevel, duration = GetPotionDetails(displayName)
        
        if potionName and duration then
            local loopThread = task.spawn(function()
                print(string.format("Auto-Loop started for %s (%d mins)", displayName, duration))
                while isAutoPotionEnabled do
                    print(string.format("Auto-Using: %s", displayName))
                    UsePotion(potionName, potionLevel)
                    task.wait(duration * 60)
                end
                print(string.format("Auto-Loop stopped for %s", displayName))
            end)
            table.insert(autoPotionLoops, loopThread)
        else
            warn(string.format("Could not find details or duration for: %s", displayName))
        end
    end
end

