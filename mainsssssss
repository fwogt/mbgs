--- Gets the internal Name and Level from a DisplayName.
-- @param displayName (string) The UI-facing name (e.g., "Coins I").
-- @return (string) potionName, (number) potionLevel, (number) duration
local function GetPotionDetails(displayName)
    for _, potion in ipairs(AllPotions) do
        if potion.DisplayName == displayName then
            return potion.Name, potion.Level, potion.Duration
        end
    end
    return nil, nil, nil
end

