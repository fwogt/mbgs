--- Fires the remote event to use a potion.
-- @param potionName (string) The internal name of the potion (e.g., "Coins").
-- @param potionLevel (number) The level of the potion (e.g., 1).
local function UsePotion(potionName, potionLevel)
    if potionName and potionLevel then
        RemoteEvent:FireServer("UsePotion", potionName, potionLevel)
        print("Used Potion:", potionName, "Level:", potionLevel)
    else
        warn("Invalid Potion Details:", potionName, potionLevel)
    end
end

