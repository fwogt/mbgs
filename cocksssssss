--// CONFIG ----------------------------------------------------------------
local CONFIG_FOLDER = Instance.new("Folder")
CONFIG_FOLDER.Name = ".ftgs_config"
CONFIG_FOLDER.Parent = Workspace

local function getConfig(n,d) 
    local c = CONFIG_FOLDER:FindFirstChild(n)
    if c and c:IsA("StringValue") then return c.Value end
    local v = Instance.new("StringValue")
    v.Name = n; v.Value = tostring(d); v.Parent = CONFIG_FOLDER
    return tostring(d)
end

local function setConfig(n,v) 
    local c = CONFIG_FOLDER:FindFirstChild(n)
    if not c then c = Instance.new("StringValue"); c.Name = n; c.Parent = CONFIG_FOLDER end
    c.Value = tostring(v)
end

