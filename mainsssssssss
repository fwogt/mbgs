--// HATCH LISTENER
RemoteEvent.OnClientEvent:Connect(function(action, data)
    if action ~= "HatchEgg" or not data or not data.Pets then return end
    local pets = data.Pets
    local count = 0
    for _, p in ipairs(pets) do
        if not p.Deleted then
            count += 1
            local name = p.Pet.Name or "Unknown"
            petStats[name] = petStats[name] or {N=0,M=0,S=0,SM=0,T=0}
            local s = petStats[name]
            if p.Pet.Shiny and p.Pet.Mythic then s.SM += 1
            elseif p.Pet.Shiny then s.S += 1
            elseif p.Pet.Mythic then s.M += 1
            else s.N += 1 end
            s.T += 1
            local txt = string.format("%-18s %-6d %-6d %-6d %-8d %-6d", name, s.N, s.M, s.S, s.SM, s.T)
            if not s.Label then s.Label = PetListSection:CreateLabel(txt)
            else s.Label:Set(txt) end
        end
    end
    if count > 0 then
        totalHatches += count
        hatchLabel:Set("Total Hatches: " .. totalHatches)
    end
end)

