-- Auto Potions
local isAutoPotionEnabled = false
local autoPotionLoops = {}
local AutoPotionsSelect = AutoModeSection:CreateMultiDropdown({ Name = "Select Potions", Options = PotionDisplayNames, CurrentValue = {}, Callback = function() if isAutoPotionEnabled then StartAuto() end end })
local AutoPotionToggle = AutoModeSection:CreateToggle({ Name = "Enable Auto", CurrentValue = false, Callback = function(v) isAutoPotionEnabled = v; if v then StartAuto() else StopAuto() end end })

function StopAuto()
    isAutoPotionEnabled = false
    for _, t in ipairs(autoPotionLoops) do task.cancel(t) end
    autoPotionLoops = {}
end

function StartAuto()
    StopAuto()
    isAutoPotionEnabled = true
    for _, name in ipairs(AutoPotionsSelect.Value) do
        local n, l, d = GetPotionDetails(name)
        if n and d then
            local t = task.spawn(function()
                while isAutoPotionEnabled do
                    UsePotion(n, l)
                    task.wait(d * 60)
                end
            end)
            table.insert(autoPotionLoops, t)
        end
    end
end

-- Manual Schedules
local ManualSchedules = {}
ManualModeSection:CreateButton({
    Name = "Add Schedule",
    Callback = function()
        local id = "S_"..tick()
        local data = {Enabled = false, Timer = 15, Potion = PotionDisplayNames[1], Thread = nil}
        local sec = ManualSchedulesListSection:CreateSection("Schedule")
        sec:CreateDropdown({Name="Potion", Options=PotionDisplayNames, CurrentValue=data.Potion, Callback=function(v) data.Potion=v end})
        sec:CreateInput({Name="Mins", PlaceholderText="15", NumbersOnly=true, CurrentValue=data.Timer, Callback=function(v) data.Timer=tonumber(v) or 15 end})
        sec:CreateToggle({Name="Enable", CurrentValue=false, Callback=function(v)
            data.Enabled = v
            if v then
                data.Thread = task.spawn(function()
                    while data.Enabled do
                        local n, l = GetPotionDetails(data.Potion)
                        UsePotion(n, l)
                        task.wait(data.Timer * 60)
                    end
                end)
            else
                if data.Thread then task.cancel(data.Thread) end
            end
        end})
        sec:CreateButton({Name="Remove", Callback=function() sec:Destroy(); ManualSchedules[id]=nil end})
        ManualSchedules[id] = data
    end
})

